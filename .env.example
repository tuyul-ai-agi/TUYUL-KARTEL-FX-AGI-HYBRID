# TUYUL-FX-HYBRID v5.4.0 Configuration

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=v5.4.0
DEBUG=False

# OpenAI/GPT Configuration
OPENAI_API_KEY=your_openai_api_key_here
GPT_MODEL=gpt-4-turbo-preview
GPT_MAX_TOKENS=4096
GPT_TEMPERATURE=0.7

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_KNOWLEDGE_VAULT_REPO=your-org/knowledge-vault
GITHUB_JOURNAL_VAULT_REPO=your-org/journal-vault

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/tuyul_agi

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# OCR Configuration
TESSERACT_PATH=/usr/bin/tesseract
OCR_LANG=eng+ind

# Adaptive Learning Configuration
LEARNING_RATE=0.001
BATCH_SIZE=32
EPOCHS=100

# Security
SECRET_KEY=your-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/tuyul-fx-hybrid.log
