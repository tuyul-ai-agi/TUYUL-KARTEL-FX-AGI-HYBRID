##############################################
# 🧠 TUYUL-KARTEL-FX-AGI-HYBRID v5.4.4
# ENVIRONMENT SECRETS TEMPLATE
# Konfigurasi koneksi Vaults, GPT API, dan CI/CD bridge
##############################################

### 🔐 GITHUB / WORKFLOW AUTH ###
GITHUB_TOKEN=<your_github_personal_access_token>
GH_USERNAME=<your_github_username>
GH_REPO="tjx578/TUYUL-KARTEL-FX-AGI-HYBRID"

### 🧠 GPT / OPENAI BRIDGE ###
OPENAI_API_KEY=<your_openai_api_key>
OPENAI_API_BASE="https://api.openai.com/v1"
GPT_MODEL="gpt-5-turbo"
GPT_ORCHESTRATOR_EMAIL="agi@tuyulkartel.ai"

### 💾 VAULT AUTH TOKENS ###
FX_VAULT_TOKEN=<fx_vault_api_token>
KARTEL_VAULT_TOKEN=<kartel_vault_api_token>
JOURNAL_VAULT_TOKEN=<journal_vault_api_token>

### 🌐 VAULT API BASE URLS ###
FX_VAULT_BASE_URL="https://api.fxvault.tuyulkartel.ai"
KARTEL_VAULT_BASE_URL="https://api.kartelvault.tuyulkartel.ai"
JOURNAL_VAULT_BASE_URL="https://api.journalvault.tuyulkartel.ai"

### 🔗 HYBRID CORE API ###
HYBRID_CORE_URL="https://api.hybridcore.tuyulkartel.ai/v1"
HYBRID_REFLEX_API="https://api.hybridcore.tuyulkartel.ai/reflex"
HYBRID_FUSION_API="https://api.hybridcore.tuyulkartel.ai/fusion"
HYBRID_REFLECTIVE_API="https://api.hybridcore.tuyulkartel.ai/reflective"

### ⚙️ INTERNAL SERVICES ###
META_LEARNING_URL="https://meta.tuyulkartel.ai/train"
TELEMETRY_URL="https://telemetry.tuyulkartel.ai"
MONITOR_URL="https://monitor.tuyulkartel.ai"

### 🤖 TELEGRAM BOT ALERT ###
TELEGRAM_BOT_TOKEN=<telegram_bot_token>
TELEGRAM_CHAT_ID=<telegram_chat_id>

### 🧬 REFLECTIVE PARAMETERS OVERRIDE ###
REFLECTIVE_LR=0.001
REFLECTIVE_REG=0.02
REFLECTIVE_DECAY=0.95
REFLECTIVE_INTENSITY=1.2
REFLECTIVE_THRESHOLD=0.85

### 🧩 ENVIRONMENT CONFIG ###
ENV_PROFILE="prod"        # dev | stage | prod
BRANCH_MAIN="main"
DEBUG_MODE=false
SYNC_INTERVAL_MIN=60

### 🧰 CI / BACKUP CONFIG ###
BACKUP_BRANCH="vault-backup"
BACKUP_RETENTION_DAYS=14
AUTO_COMMIT_USER="AGI Sync Bot"
AUTO_COMMIT_EMAIL="agi@tuyulkartel.ai"

### 🪵 LOGGING & REPORTING ###
LOG_LEVEL="INFO"
LOG_PATH="./logs/runtime_hybrid.log"
AUDIT_REPORT_PATH="./logs/vault_sync.log"

### 🧱 CONTAINER (DOCKER) CONFIG ###
DOCKER_REGISTRY="ghcr.io/tjx578"
DOCKER_IMAGE_NAME="tuyul-hybrid"
DOCKER_TAG="v5.4.4"

##############################################
# End of secrets_template.env
##############################################
